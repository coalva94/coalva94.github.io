---
import { site } from '../data/config.js';
import ActionButton from './ActionButton.astro';
---

<section id="contacto">
  <div class="mx-auto max-w-5xl px-4 py-14 md:py-20">
    <h2 class="text-2xl font-semibold tracking-tight text-text-bright md:text-3xl">Contacto</h2>
    <p class="mt-6 max-w-2xl text-base leading-relaxed text-text-bright md:text-lg">{site.contact}</p>
    <ul class="mt-6 space-y-3 text-base">
      <li>
        <a class="font-medium text-accent-text underline decoration-accent-border underline-offset-4" href={`mailto:${site.email}`}>
          {site.email}
        </a>
      </li>
      <li>
        <a class="font-medium text-accent-text underline decoration-accent-border underline-offset-4" href={site.phoneHref}>
          {site.phone}
        </a>
      </li>
      <li>
        <a
          class="font-medium text-accent-text underline decoration-accent-border underline-offset-4"
          href={site.linkedin.href}
          target="_blank"
          rel="noopener noreferrer"
        >
          {site.linkedin.label}
          <span class="sr-only"> (se abre en una pestaña nueva)</span>
        </a>
      </li>
    </ul>
    <div class="mt-8">
      <ActionButton href={site.cv.href} label={site.cv.label} icon="download" variant="primary" download={site.cv.filename} />
    </div>
  </div>
</section>
