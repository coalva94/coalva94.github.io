---
import { projects } from '../data/projects.js';
---

<section id="proyectos" class="border-b border-card-border">
  <div class="mx-auto max-w-5xl px-4 py-14 md:py-20">
    <h2 class="text-2xl font-semibold tracking-tight text-text-bright md:text-3xl">Proyectos de IA aplicada</h2>
    <div class="mt-8 grid grid-cols-1 gap-4 md:grid-cols-2">
      {
        projects.map((project) => (
          <article class="rounded-2xl border border-card-border bg-card-bg p-6">
            <h3 class="text-lg font-semibold leading-snug text-text-bright">{project.title}</h3>
            <p class="mt-3 text-sm font-medium leading-relaxed text-accent-text">{project.tags.join(' · ')}</p>
            <p class="mt-3 text-base leading-relaxed text-text-muted">{project.description}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
