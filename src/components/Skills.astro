---
import { site } from '../data/config.js';
---

<section id="habilidades" class="border-b border-card-border">
  <div class="mx-auto max-w-5xl px-4 py-14 md:py-20">
    <h2 class="text-2xl font-semibold tracking-tight text-text-bright md:text-3xl">Habilidades</h2>
    <div class="mt-8 grid grid-cols-1 gap-4 md:grid-cols-2">
      {
        site.skills.map((group) => (
          <article class="rounded-2xl border border-card-border bg-card-bg p-6">
            <h3 class="text-base font-semibold text-text-bright">{group.category}</h3>
            <ul class="mt-4 flex flex-wrap gap-2">
              {group.items.map((item) => (
                <li class="rounded-full border border-accent-border bg-accent-bg px-3 py-1.5 text-sm text-text-bright">
                  {item}
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>
