---
import { portfolioConfig } from '../data/config.js';
const { bio, avatar, experience, education, certifications } = portfolioConfig.aboutMe;
---

<section class="w-full max-w-6xl mx-auto px-4 py-12 md:py-12s">
  <!-- Profile Header (Cardless Layout, replaces 'Perfil Profesional' card) -->
  <div class="flex flex-col md:flex-row items-center md:items-start gap-8 pb-6 border-b border-card-border mb-12">
    <!-- Avatar Portrait -->
    <div class="relative w-32 h-32 rounded-full overflow-hidden border-2 border-accent-text/30 p-1 bg-bg-main shrink-0">
      <img
        src={avatar}
        alt={portfolioConfig.name}
        class="w-full h-full object-cover rounded-full"
        loading="lazy"
      />
    </div>

    <!-- Bio & Details -->
    <div class="flex-1 text-center md:text-left">
      <h2 class="text-3xl font-extrabold tracking-tight text-text-bright mb-1">
        {portfolioConfig.name}
      </h2>
      <p class="text-xs font-mono text-accent-text mb-4">{portfolioConfig.title}</p>
      
      <p class="text-sm text-text-muted leading-relaxed text-justify mb-5">
        {bio}
      </p>

      <!-- Botones de Acción -->
      <div class="flex flex-wrap gap-3 justify-center md:justify-end">
        <a
          href="/docs/CV_CarlosAlva_Es.pdf"
          download="CV_CarlosAlva_Es.pdf"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-linear-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-white font-extrabold text-xs transition-all shadow-lg shadow-cyan-500/20 glow-hover"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
          </svg>
          Descargar CV
        </a>
        <a
          href={portfolioConfig.linkedInUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-[#0077b5] hover:bg-[#006297] text-white font-bold text-xs transition-colors shadow-lg shadow-blue-900/20"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.779-1.75-1.75s.784-1.75 1.75-1.75 1.75.779 1.75 1.75-.784 1.75-1.75 1.75zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
          </svg>
          Conectar en LinkedIn
        </a>
      </div>
    </div>
  </div>

  <!-- Experience & Qualifications Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    
    <!-- Experience Timeline (8 cols) -->
    <div class="lg:col-span-8 flex flex-col gap-6">
      <div class="p-6 bg-card-bg border border-card-border rounded-xl">
        <h3 class="text-sm font-bold uppercase tracking-wider text-text-bright mb-6 font-mono border-b border-card-border pb-2 flex items-center gap-2">
          <svg class="w-4 h-4 text-accent-text" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
          </svg>
          Experiencia Profesional
        </h3>
        
        <div class="relative border-l border-card-border pl-6 ml-3 flex flex-col gap-8">
          {experience.map((exp) => (
            <div class="relative">
              <!-- Timeline node dot -->
              <span class="absolute -left-[31px] top-1.5 w-3 h-3 rounded-full bg-accent-text border-2 border-card-bg shadow-[0_0_8px_var(--color-accent-text)]"></span>
              
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1 mb-2">
                <h4 class="text-sm font-bold text-text-bright">{exp.role}</h4>
                <span class="text-[10px] font-mono font-semibold px-2 py-0.5 rounded bg-accent-bg border border-accent-border text-accent-text self-start sm:self-auto">
                  {exp.period}
                </span>
              </div>
              <p class="text-xs font-semibold text-accent-text/80 mb-2">{exp.company}</p>
              <p class="text-xs text-text-muted leading-relaxed text-justify">
                {exp.description}
              </p>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Education & Certifications (4 cols) -->
    <div class="lg:col-span-4 flex flex-col gap-6 py-6">
      
      <!-- Certifications Card -->
      <div class="p-6 bg-card-bg border border-card-border rounded-xl">
        <h3 class="text-sm font-bold uppercase tracking-wider text-text-bright mb-4 font-mono border-b border-card-border pb-2 flex items-center gap-2">
          <svg class="w-4 h-4 text-accent-text" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/>
          </svg>
          Certificaciones
        </h3>
        <div class="flex flex-col gap-3">
          {certifications.map((cert) => (
            <div class="flex items-start gap-2.5">
              <span class="mt-1 w-1.5 h-1.5 rounded-full bg-accent-text shrink-0"></span>
              <div>
                <p class="text-xs font-semibold text-text-bright leading-tight">{cert.name}</p>
                <p class="text-[10px] text-text-muted">{cert.issuer} &middot; {cert.year}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Education Card -->
      <div class="p-6 bg-card-bg border border-card-border rounded-xl">
        <h3 class="text-sm font-bold uppercase tracking-wider text-text-bright mb-4 font-mono border-b border-card-border pb-2 flex items-center gap-2">
          <svg class="w-4 h-4 text-accent-text" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5l4-2.222"/>
          </svg>
          Estudios Académicos
        </h3>
        <div class="grid grid-cols-1 gap-4">
          {education.map((edu) => (
            <div class="p-4 bg-bg-main/50 rounded-lg border border-card-border hover:border-accent-border transition-all">
              <h4 class="text-xs font-bold text-text-bright mb-1">{edu.degree}</h4>
              <p class="text-[11px] text-text-muted mb-2">{edu.institution}</p>
              <span class="text-[10px] font-mono text-accent-text font-semibold">{edu.year}</span>
            </div>
          ))}
        </div>
      </div>

    </div>
  </div>
</section>
