---
import { site } from '../data/config.js';
---

<section id="sobre-mi" class="border-b border-card-border">
  <div class="mx-auto max-w-5xl px-4 py-14 md:py-20">
    <h2 class="text-2xl font-semibold tracking-tight text-text-bright md:text-3xl">Sobre mí</h2>
    <div class="mt-6 max-w-3xl space-y-4 text-base leading-relaxed text-text-bright">
      {site.about.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </div>
</section>
