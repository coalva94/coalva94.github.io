---
import { site } from '../data/config.js';
---

<section id="experiencia" class="border-b border-card-border">
  <div class="mx-auto max-w-5xl px-4 py-14 md:py-20">
    <h2 class="text-2xl font-semibold tracking-tight text-text-bright md:text-3xl">Experiencia</h2>
    <div class="mt-8 space-y-10 border-l border-card-border pl-6">
      {
        site.experience.map((job) => (
          <article class="relative">
            <span
              class="absolute -left-[31px] top-1.5 h-3 w-3 rounded-full border-2 border-card-bg bg-accent-text"
              aria-hidden="true"
            />
            <h3 class="text-lg font-semibold text-text-bright">
              {job.company}
              <span class="font-normal text-text-muted"> ({job.context})</span>
              {job.period && <span class="mt-1 block text-sm font-medium text-text-muted">{job.period}</span>}
            </h3>
            <div class="mt-4 space-y-6">
              {job.roles.map((role) => (
                <div>
                  <h4 class="text-base font-semibold text-text-bright">{role.title}</h4>
                  <p class="mt-1 text-sm font-medium text-accent-text">{role.period}</p>
                  <ul class="mt-3 list-disc space-y-2 pl-5 text-base leading-relaxed text-text-muted">
                    {role.items.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
