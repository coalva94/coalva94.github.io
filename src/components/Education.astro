---
import { site } from '../data/config.js';
---

<section id="formacion" class="border-b border-card-border">
  <div class="mx-auto max-w-5xl px-4 py-14 md:py-20">
    <h2 class="text-2xl font-semibold tracking-tight text-text-bright md:text-3xl">Formación</h2>
    <div class="mt-8 grid grid-cols-1 gap-4">
      {
        site.education.map((item) => (
          <article class="rounded-2xl border border-card-border bg-card-bg p-6">
            <h3 class="text-base font-semibold leading-snug text-text-bright">{item.degree}</h3>
            <p class="mt-2 text-base text-text-muted">{item.institution}</p>
            <p class="mt-1 text-sm font-medium text-accent-text">{item.period}</p>
          </article>
        ))
      }
    </div>
    <div class="mt-4 grid grid-cols-1 gap-4 md:grid-cols-2">
      <article class="rounded-2xl border border-card-border bg-card-bg p-6">
        <h3 class="text-base font-semibold text-text-bright">Certificaciones</h3>
        <p class="mt-3 text-base leading-relaxed text-text-muted">{site.certifications}</p>
      </article>
      <article class="rounded-2xl border border-card-border bg-card-bg p-6">
        <h3 class="text-base font-semibold text-text-bright">Idiomas</h3>
        <p class="mt-3 text-base leading-relaxed text-text-muted">{site.languages}</p>
      </article>
    </div>
  </div>
</section>
