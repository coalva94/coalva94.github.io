---
import BlogCard from './BlogCard.astro';
import { blogPosts } from '../data/blog.js';

// Ordenamos las publicaciones por fecha descendente y tomamos las últimas 4
const latestPosts = [...blogPosts]
  .sort((a, b) => new Date(b.publishDate).getTime() - new Date(a.publishDate).getTime())
  .slice(0, 4);
---

<section class="w-full max-w-6xl mx-auto px-4 py-12 md:py-16">
  <!-- Section Header -->
  <div class="mb-10 text-center md:text-left">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-accent-bg border border-accent-border mb-3">
      <span class="w-2 h-2 rounded-full bg-accent-text"></span>
      <span class="text-xs font-mono tracking-wider text-accent-text uppercase">Bitácora Profesional</span>
    </div>
    
    <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight text-text-bright mb-2">
      Bitácora de Soluciones
    </h2>
    <p class="text-sm md:text-base text-text-muted max-w-xl">
      Análisis técnicos y publicaciones sobre arquitectura empresarial, integraciones y automatizaciones.
    </p>
  </div>

  <!-- Feed Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 md:gap-8">
    {latestPosts.map((post) => (
      <BlogCard
        id={post.id}
        title={post.title}
        publishDate={post.publishDate}
        formattedDate={post.formattedDate}
        extract={post.extract}
        tags={post.tags}
        url={post.url}
      />
    ))}
  </div>
</section>
