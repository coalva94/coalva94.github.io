---
import { portfolioProjects } from '../data/projects.js';

// Mapeador de colores de lenguajes de programación
const languageColors: Record<string, string> = {
  TypeScript: "bg-blue-500",
  JavaScript: "bg-yellow-500",
  Python: "bg-green-500",
  HTML: "bg-orange-500",
  CSS: "bg-purple-500",
  Rust: "bg-red-500"
};
---

<section class="w-full max-w-6xl mx-auto px-4 py-12 md:py-16">
  <!-- Header -->
  <div class="mb-10 text-center md:text-left">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-accent-bg border border-accent-border mb-3">
      <svg class="w-3.5 h-3.5 text-accent-text" fill="currentColor" viewBox="0 0 24 24">
        <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.603-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.464-1.11-1.464-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.579.688.481C19.137 20.162 22 16.418 22 12c0-5.523-4.477-10-10-10z" clip-rule="evenodd"/>
      </svg>
      <span class="text-xs font-mono tracking-wider text-accent-text uppercase">Proyectos Destacados</span>
    </div>
    
    <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight text-text-bright mb-2">
      Soluciones en GitHub
    </h2>
    <p class="text-sm md:text-base text-text-muted max-w-xl">
      Catálogo de repositorios y proyectos de código abierto gestionados localmente para mayor estabilidad.
    </p>
  </div>

  <!-- Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {portfolioProjects.map((repo: any) => (
      <div class="relative flex flex-col justify-between p-6 bg-card-bg border border-card-border rounded-xl hover:border-accent-border transition-all duration-300 group hover:shadow-[0_0_20px_var(--color-accent-border)]">
        <!-- Accent line -->
        <div class="absolute top-0 left-6 right-6 h-px bg-linear-to-r from-transparent via-accent-text/20 to-transparent"></div>

        <div>
          <!-- Title & Stats -->
          <div class="flex items-center justify-between gap-4 mb-3">
            <h3 class="text-base font-bold text-text-bright group-hover:text-accent-text transition-colors font-mono truncate">
              {repo.name}
            </h3>
            
            <div class="flex items-center gap-3 text-xs text-text-muted">
              <!-- Stars -->
              <span class="flex items-center gap-1">
                <svg class="w-3.5 h-3.5 text-yellow-500" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                </svg>
                {repo.stargazers_count}
              </span>
              <!-- Forks -->
              <span class="flex items-center gap-1">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M8 7a3 3 0 100-6 3 3 0 000 6zM8 7v7a4 4 0 00.414 1.757l3.586 3.586M16 17a3 3 0 100-6 3 3 0 000 6zM16 17v2a2 2 0 01-2 2H8.414a2 2 0 01-1.414-.586L3.5 17"/>
                </svg>
                {repo.forks_count}
              </span>
            </div>
          </div>

          <!-- Description -->
          <p class="text-xs leading-relaxed text-text-muted line-clamp-3 mb-4">
            {repo.description || "Este repositorio no cuenta con una descripción pública cargada."}
          </p>
        </div>

        <!-- Footer -->
        <div class="mt-auto pt-4 border-t border-card-border flex items-center justify-between gap-3">
          <!-- Primary Language -->
          {repo.language && (
            <div class="flex items-center gap-1.5">
              <span class={`w-2.5 h-2.5 rounded-full ${languageColors[repo.language] || 'bg-gray-400'}`}></span>
              <span class="text-xs font-semibold text-text-muted">{repo.language}</span>
            </div>
          )}

          <!-- Topics tags -->
          {!repo.language && repo.topics && repo.topics.length > 0 && (
            <div class="flex gap-1">
              {repo.topics.slice(0, 2).map((t: string) => (
                <span class="text-[10px] text-accent-text font-mono">#{t}</span>
              ))}
            </div>
          )}

          <!-- Link -->
          <a
            href={repo.html_url}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center text-xs font-semibold text-accent-text hover:text-text-bright transition-colors duration-200"
          >
            <span class="font-mono mr-1">[</span> Ver en GitHub <span class="font-mono ml-1">]</span>
            <svg class="w-3 h-3 ml-1 transform group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
            </svg>
          </a>
        </div>
      </div>
    ))}
  </div>
</section>
