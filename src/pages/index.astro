---
import '../styles/global.css';
import AboutMe from '../components/AboutMe.astro';
import GithubProjects from '../components/GithubProjects.astro';
import BlogFeed from '../components/BlogFeed.astro';
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="Portfolio Ejecutivo de Soluciones de Integración y Modernización Digital." />
		<title>Executive Portfolio & Solution Log</title>
		<!-- Google Fonts Inter -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">
		
		<script is:inline>
			// Set theme on load to avoid FOUC
			if (localStorage.getItem('theme') === 'light' || (!('theme' in localStorage) && !window.matchMedia('(prefers-color-scheme: dark)').matches)) {
				document.documentElement.classList.remove('dark');
			} else {
				document.documentElement.classList.add('dark');
			}
		</script>
	</head>
	<body class="bg-bg-main text-text-bright antialiased selection:bg-cyan-500/30 selection:text-cyan-200">
		
		<!-- Subtle background gradient grid -->
		<div class="absolute inset-0 bg-[linear-gradient(to_right,#1f293710_1px,transparent_1px),linear-gradient(to_bottom,#1f293710_1px,transparent_1px)] bg-size-[4rem_4rem] mask-[radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)] pointer-events-none"></div>

		<!-- Nav Bar -->
		<header class="sticky top-0 z-50 w-full border-b border-card-border bg-bg-main/80 backdrop-blur-md">
			<div class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between">
				<div class="flex items-center gap-3">
					<div class="w-8 h-8 rounded-lg bg-linear-to-tr from-brand-primary to-brand-secondary flex items-center justify-center text-white">
						<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" xmlns="http://www.w3.org/2000/svg">
							<path stroke-linecap="round" stroke-linejoin="round" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
						</svg>
					</div>
					<span class="font-bold tracking-tight text-text-bright font-mono text-sm hidden sm:inline-block">PORTFOLIO</span>
				</div>
				<div class="flex items-center gap-6">
					<nav class="flex items-center gap-6">
						<a href="#" class="text-xs font-semibold text-cyan-400 hover:text-text-bright transition-colors uppercase tracking-wider">Inicio</a>
						<a href="#about" class="text-xs font-semibold text-text-muted hover:text-text-bright transition-colors uppercase tracking-wider">Sobre mí</a>
						<a href="#projects" class="text-xs font-semibold text-text-muted hover:text-text-bright transition-colors uppercase tracking-wider">Proyectos</a>
						<a href="#blog" class="text-xs font-semibold text-text-muted hover:text-text-bright transition-colors uppercase tracking-wider">Bitácora</a>
					</nav>

					<!-- Theme Toggle Button -->
					<button id="theme-toggle" class="p-2 rounded-lg border border-card-border hover:border-cyan-500/30 text-text-muted hover:text-cyan-400 transition-colors cursor-pointer" aria-label="Toggle theme">
						<!-- Sun Icon -->
						<svg id="theme-toggle-light-icon" class="w-4 h-4 hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707m0-12.728l.707.707m12.728 12.728l.707.707M12 8a4 4 0 100 8 4 4 0 000-8z"></path>
						</svg>
						<!-- Moon Icon -->
						<svg id="theme-toggle-dark-icon" class="w-4 h-4 hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
						</svg>
					</button>
				</div>
			</div>
		</header>

		<!-- Main Layout (No Hero Section, starting directly with profile and solutions log) -->
		<main class="relative z-10">
			<!-- About Me Section -->
			<section id="about" class="border-b border-card-border bg-card-bg/20">
				<AboutMe />
			</section>
	
			<!-- Github Projects Section -->
			<section id="projects" class="border-b border-card-border bg-bg-main/50">
				<GithubProjects />
			</section>
	
			<!-- Blog Feed Container -->
			<section id="blog" class="bg-card-bg/20">
				<BlogFeed />
			</section>
		</main>

		<!-- Footer -->
		<footer class="border-t border-card-border bg-bg-main">
			<div class="max-w-6xl mx-auto px-4 py-8 flex flex-col sm:flex-row items-center justify-between gap-4">
				<p class="text-xs text-text-muted">
					&copy; 2026 Portfolio Ejecutivo, Todos los derechos reservados.
				</p>
			</div>
		</footer>

		<!-- Theme Toggle Script -->
		<script is:inline>
			const themeToggleBtn = document.getElementById('theme-toggle');
			const lightIcon = document.getElementById('theme-toggle-light-icon');
			const darkIcon = document.getElementById('theme-toggle-dark-icon');

			function updateToggleButtons() {
				const isDark = document.documentElement.classList.contains('dark');
				if (isDark) {
					lightIcon?.classList.remove('hidden');
					darkIcon?.classList.add('hidden');
				} else {
					lightIcon?.classList.add('hidden');
					darkIcon?.classList.remove('hidden');
				}
			}

			updateToggleButtons();

			themeToggleBtn?.addEventListener('click', function() {
				document.documentElement.classList.toggle('dark');
				const isDark = document.documentElement.classList.contains('dark');
				localStorage.setItem('theme', isDark ? 'dark' : 'light');
				updateToggleButtons();
			});
		</script>
	</body>
</html>
